@tailwind utilities;
:host { all: initial; font-family: Arial, sans-serif; color: #202520; }
.et-launcher { @apply et-bg-blue-500; position: fixed; bottom: max(1rem, env(safe-area-inset-bottom)); right: 1rem; z-index: var(--et-z-index); background: var(--et-accent); color: white; border: 0; border-radius: 50%; width: 3.75rem; height: 3.75rem; padding: 0; display: grid; place-items: center; box-shadow: 0 4px 18px #0003; cursor: pointer; transition: background-color .15s ease, transform .15s ease; }
.et-launcher:hover { @apply et-bg-orange-500; transform: translateY(-2px); }
.et-launcher:focus-visible { outline: 3px solid #F3920B; outline-offset: 3px; }
.et-launcher-icon { width: 1.8rem; height: 1.8rem; fill: currentColor; }
.et-left.et-launcher,.et-left.et-window { left: 1rem; right: auto; }
.et-window { position: fixed; z-index: var(--et-z-index); right: 1rem; bottom: max(1rem, env(safe-area-inset-bottom)); width: min(380px, calc(100vw - 2rem)); height: min(560px, calc(100dvh - 2rem - env(safe-area-inset-top))); display: flex; flex-direction: column; background: #fff; border-radius: 1rem; box-shadow: 0 8px 36px #0004; border: 1px solid #d9dfda; overflow: hidden; transform-origin: bottom right; animation: et-support-chat-open 260ms cubic-bezier(.2,.8,.2,1) both; }
.et-window.et-left { transform-origin: bottom left; }
.et-window.et-closing { animation: et-support-chat-close 210ms cubic-bezier(.4,0,1,1) both; pointer-events: none; }
@keyframes et-support-chat-open { from { opacity: 0; transform: scale(.12); } to { opacity: 1; transform: scale(1); } }
@keyframes et-support-chat-close { from { opacity: 1; transform: scale(1); } to { opacity: 0; transform: scale(.12); } }
.et-header { @apply et-bg-blue-500; background: var(--et-accent); color: white; padding: .9rem 1rem; display: flex; justify-content: space-between; align-items: center; }
.et-brand { display: flex; align-items: center; gap: .65rem; font-size: 1rem; letter-spacing: .01em; }
.et-brand-logo { width: 2rem; height: 1.9rem; flex: none; }
.et-close { background: transparent; color: inherit; border: 0; font-size: 1.5rem; cursor: pointer; }
.et-body { padding: 1rem; overflow-y: auto; flex: 1; line-height: 1.55; font-size: .9rem; }
.et-notices { display: grid; gap: .3rem; margin: 0 0 .75rem; }
.et-note,.et-hint { display: flex; align-items: center; gap: .4rem; font-size: .72rem; line-height: 1.35; margin: 0; border-radius: .35rem; padding: .35rem .5rem; }
.et-note { background: #f6f9fb; color: #5a6d7d; border-left: 2px solid #b7d2e1; }
.et-note a { color: #1f7298; font-weight: 600; white-space: nowrap; }
.et-note-badge { display: grid; place-items: center; width: 1rem; height: 1rem; color: #6d9bb4; flex: none; }
.et-hint { background: #fcfaf5; color: #75674f; border-left: 2px solid #e8d5ab; }
.et-hint-icon { display: grid; place-items: center; width: .95rem; height: .95rem; border: 1px solid #c6ae7c; border-radius: 50%; color: #947a48; font-weight: 700; font-size: .65rem; flex: none; }
.et-bubble { max-width: 90%; padding: .85rem 1rem; border-radius: 1rem; margin: .85rem 0; white-space: pre-wrap; overflow-wrap: anywhere; line-height: 1.65; box-shadow: 0 1px 3px #13283b12; }
.et-assistant { background: #f5f7fa; border: 1px solid #e4e9ef; border-bottom-left-radius: .3rem; color: #263445; }
.et-user { @apply et-bg-blue-200; margin-left: auto; border-bottom-right-radius: .3rem; color: #18364c; }
.et-markdown :first-child { margin-top: 0; }
.et-markdown :last-child { margin-bottom: 0; }
.et-markdown p,.et-markdown ul,.et-markdown ol,.et-markdown blockquote,.et-markdown pre { margin: .45rem 0; }
.et-markdown ul,.et-markdown ol { padding-left: 1.35rem; }
.et-markdown li+li { margin-top: .2rem; }
.et-markdown h1,.et-markdown h2,.et-markdown h3,.et-markdown h4,.et-markdown h5,.et-markdown h6 { font-weight: 700; line-height: 1.3; margin: .65rem 0 .35rem; }
.et-markdown blockquote { border-left: 3px solid #b7c7d8; padding-left: .65rem; color: #526275; }
.et-markdown code { background: #e9edf2; border-radius: .2rem; padding: .08rem .25rem; font-family: monospace; }
.et-markdown pre { overflow-x: auto; white-space: pre; }
.et-markdown pre code { display: block; padding: .6rem; }
.et-markdown a { color: #1f7298; text-decoration: underline; }
.et-sources { display: grid; gap: .35rem; list-style: none; margin: .7rem 0 0; padding: .65rem 0 0; border-top: 1px solid #dce3ea; font-size: .78rem; color: #526275; }
.et-sources-label { font-weight: 700; color: #34485c; }
.et-loading { display: inline-flex; align-items: center; gap: .7rem; margin: .5rem 0 .8rem; padding: .65rem .85rem; border-radius: 1rem 1rem 1rem .3rem; background: #f5f7fa; border: 1px solid #e4e9ef; color: #526275; font-size: .84rem; }
.et-loading-dots { display: inline-flex; gap: .22rem; align-items: center; }
.et-loading-dots i { width: .38rem; height: .38rem; border-radius: 50%; background: #28a8df; animation: et-chat-typing 1.1s infinite ease-in-out; }
.et-loading-dots i:nth-child(2) { animation-delay: .14s; }
.et-loading-dots i:nth-child(3) { animation-delay: .28s; }
@keyframes et-chat-typing { 0%,60%,100% { opacity: .4; transform: translateY(0); } 30% { opacity: 1; transform: translateY(-.28rem); } }
.et-email,.et-action { display: grid; gap: .55rem; border: 1px solid #d9dfda; border-radius: .75rem; padding: .75rem; margin: .7rem 0; }
input,textarea { font: inherit; border: 1px solid #9aa49d; border-radius: .4rem; padding: .55rem; width: 100%; box-sizing: border-box; }
button { font: inherit; }
.et-email button,.et-action button,.et-composer button,.et-new-chat { @apply et-bg-blue-500; border: 0; border-radius: .45rem; padding: .55rem .8rem; background: var(--et-accent); color: white; cursor: pointer; }
.et-chat-ended { display: grid; gap: .6rem; max-width: 22rem; margin: 2rem auto; }
.et-chat-ended p[role="status"] { margin: 0; }
.et-new-chat { justify-self: start; font-weight: 600; }
button:disabled { opacity: .55; cursor: not-allowed; }
.et-composer { display: flex; gap: .4rem; padding: .65rem; border-top: 1px solid #ddd; align-items: end; }
.et-composer textarea { resize: vertical; min-height: 2.6rem; max-height: 6rem; }
.et-end { align-self: flex-start; margin: 0 .7rem .6rem; border: 0; background: transparent; text-decoration: underline; cursor: pointer; }
.et-error,p[role="alert"] { @apply et-bg-red-500 et-text-white et-text-sm et-font-semibold et-rounded-lg; margin: .6rem 0; padding: .7rem .85rem; line-height: 1.45; }
p[role="status"] { @apply et-bg-green-500 et-text-white et-text-sm et-font-semibold et-rounded-lg; margin: .6rem 0; padding: .7rem .85rem; line-height: 1.45; }
.et-sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
@media (max-width: 600px) { .et-window { inset: env(safe-area-inset-top) 0 env(safe-area-inset-bottom); width: 100%; height: auto; border-radius: 0; } .et-launcher { right: 1rem; } }
@media (prefers-reduced-motion: reduce) { *,*::before,*::after { scroll-behavior: auto !important; animation-duration: .01ms !important; } }
